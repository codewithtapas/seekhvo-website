# ============================================================
# SEEKHVO AI LEARNING — Production Git Ignore Policy
# ============================================================

# Environment variables & secrets (NEVER commit actual secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.pem
*.key
*.cert
*.crt
credentials.json
client_secrets.json

# Explicitly allow the sanitized example environment file
!.env.example

# Python & Django
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# Virtual Environments
.venv/
venv/
ENV/
env/
backend/.venv/
env.bak/
venv.bak/

# Django local databases, media & collected static assets
db.sqlite3
db.sqlite3-journal
db.sqlite3-shm
db.sqlite3-wal
backend/db.sqlite3
backend/db.sqlite3-journal
media/
backend/media/
staticfiles/
backend/staticfiles/

# Node.js & Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
.turbo/
tsconfig.tsbuildinfo
frontend/tsconfig.tsbuildinfo
next-env.d.ts.bak

# Logs & Debuggers
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.pid
*.seed
*.pid.lock

# Test & Coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/

# Temporary / Scratch
scratch/
tmp/
temp/
.cache/

# OS & Editor generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
