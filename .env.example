# ============================================================
# SEEKHVO AI LEARNING (seekhvo.space) — Environment Variables
# ============================================================

# Core Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-50-char-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,seekhvo.space,www.seekhvo.space,api.seekhvo.space
SITE_URL=http://localhost:3000
API_URL=http://localhost:8000

# Database (PostgreSQL in Docker/Prod; SQLite fallback if USE_SQLITE=True)
USE_SQLITE=True
POSTGRES_DB=seekhvo_db
POSTGRES_USER=seekhvo_user
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache & Rate Limiting (falls back to LocMemCache if REDIS_URL is empty in dev)
REDIS_URL=

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://seekhvo.space,https://www.seekhvo.space
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://seekhvo.space,https://www.seekhvo.space

# S3 / Cloudflare R2 Compatible Storage (set USE_S3_STORAGE=True in prod)
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=seekhvo-media
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=

# Transactional Email (console | smtp | resend)
EMAIL_PROVIDER=console
DEFAULT_FROM_EMAIL=Seekhvo AI Learning <noreply@seekhvo.space>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
RESEND_API_KEY=

# Payment Gateway (sandbox | razorpay | cashfree)
PAYMENT_PROVIDER=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=SANDBOX
SANDBOX_WEBHOOK_SECRET=seekhvo-sandbox-webhook-secret

# WhatsApp Business Integration (Server-side Cloud API + Public Click-to-Chat)
WHATSAPP_API_ENABLED=False
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PUBLIC_NUMBER=919000000000

# Frontend Public Configuration (Safe to expose)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
